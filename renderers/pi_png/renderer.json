{
  "tesserae_compat": "1.x",
  "name": "Pi client (PNG)",
  "version": "0.1.0",
  "description": "Composition PNG, rotated to the Pi client's landscape-native pixel grid. Published non-retained to tesserae/pi/frame/png with the v3-frozen options payload (rotate / scale / bg / saturation) so an existing inky-dash listener works without firmware changes.",
  "orientation": "landscape",
  "mime": "image/png",
  "extension": "png",
  "topic_pattern": "tesserae/{device}/frame/png",
  "device": "pi",
  "retain": false,
  "settings": [
    {
      "name": "rotate",
      "type": "select",
      "label": "Client rotation (quarter-turns)",
      "default": 0,
      "choices": [
        { "value": 0, "label": "0°" },
        { "value": 1, "label": "90° CW" },
        { "value": 2, "label": "180°" },
        { "value": 3, "label": "270° CW" }
      ]
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Client-side scale mode",
      "default": "fit",
      "choices": [
        { "value": "fit", "label": "Fit" },
        { "value": "fill", "label": "Fill" },
        { "value": "stretch", "label": "Stretch" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "name": "bg",
      "type": "select",
      "label": "Letterbox colour",
      "default": "white",
      "choices": [
        { "value": "white", "label": "White" },
        { "value": "black", "label": "Black" },
        { "value": "red", "label": "Red" },
        { "value": "green", "label": "Green" },
        { "value": "blue", "label": "Blue" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "orange", "label": "Orange" }
      ]
    },
    {
      "name": "saturation",
      "type": "slider",
      "label": "Client-side saturation",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    {
      "name": "transform_rotate_quarters",
      "type": "number",
      "label": "Server-side rotate before publish (quarter-turns CW)",
      "default": 3,
      "min": 0,
      "max": 3,
      "help": "Composition is portrait-up; the panel is landscape-native. 3 (= one 90° CCW turn) lines up with the ribbon-cable-up portrait mount and matches pi_bin's direction. Use 1 for ribbon-cable-down."
    }
  ]
}
