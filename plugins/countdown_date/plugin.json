{
  "tesserae_compat": "1.x",
  "name": "Countdown, Date",
  "version": "0.1.0",
  "kind": "widget",
  "description": "Days remaining until a target date. Glanceable single-number hero with an optional label. Pure client-side, no network.",
  "icon": "ph-calendar-blank",
  "supports": { "sizes": ["xs", "sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "target_date",
      "type": "string",
      "label": "Target date (YYYY-MM-DD)",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label (e.g. 'Holiday', 'Deadline')",
      "default": ""
    },
    {
      "name": "show_hours_under_a_day",
      "type": "boolean",
      "label": "Show hours when less than a day remains",
      "default": true
    },
    {
      "name": "show_past",
      "type": "boolean",
      "label": "Keep counting after the date passes ('5 days ago')",
      "default": true
    },
    {
      "name": "accent",
      "type": "select",
      "label": "Accent colour",
      "default": "terracotta",
      "choices": [
        { "value": "terracotta", "label": "Terracotta" },
        { "value": "ochre",       "label": "Ochre"      },
        { "value": "moss",        "label": "Moss"       },
        { "value": "teal",        "label": "Teal"       },
        { "value": "slate",       "label": "Slate blue" }
      ]
    }
  ],
  "render": { "dither": "none", "needs_network": false }
}
