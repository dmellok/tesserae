{
  "tesserae_compat": "1.x",
  "name": "Countdown, Date",
  "version": "0.1.1",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "Days remaining until a target date. Glanceable single-number hero with an optional label. Pure client-side, no network.",
  "icon": "ph-calendar-blank",
  "category": "time",
  "supports": { "sizes": ["xs", "sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "target_date",
      "placeholder": "2027-07-01",
      "type": "string",
      "label": "Date",
      "default": "",
      "help": "YYYY-MM-DD."
    },
    {
      "name": "label",
      "placeholder": "Holiday",
      "type": "string",
      "label": "Title",
      "default": "",
      "help": "For example Holiday or Deadline."
    },
    {
      "name": "show_hours_under_a_day",
      "type": "boolean",
      "label": "Hours on the last day",
      "default": true,
      "help": "Shows hours once less than a day remains."
    },
    {
      "name": "show_past",
      "type": "boolean",
      "label": "Count on afterwards",
      "default": true,
      "help": "Keeps counting after the date passes ('5 days ago')."
    },
    {
      "name": "accent",
      "type": "select",
      "label": "Accent colour",
      "default": "terracotta",
      "choices": [
        {
          "value": "terracotta",
          "label": "Terracotta"
        },
        {
          "value": "ochre",
          "label": "Ochre"
        },
        {
          "value": "moss",
          "label": "Moss"
        },
        {
          "value": "teal",
          "label": "Teal"
        },
        {
          "value": "slate",
          "label": "Slate blue"
        }
      ]
    }
  ],
  "render": { "dither": "none", "needs_network": false }
}
