{
  "tesserae_compat": "1.x",
  "name": "Year, Progress",
  "version": "0.1.1",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "How far through the year you are. Two modes: the current calendar year as a row of weekly dots, or 'life in weeks' as a long-form grid (give a birth year). Pure client-side, no network.",
  "icon": "ph-calendar-dots",
  "category": "time",
  "supports": { "sizes": ["xs", "sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "mode",
      "type": "select",
      "label": "Mode",
      "default": "year",
      "choices": [
        {
          "value": "year",
          "label": "Year in weeks"
        },
        {
          "value": "life-weeks",
          "label": "Life in weeks"
        }
      ]
    },
    {
      "name": "birth_year",
      "help": "Your four-digit birth year, used in Life in weeks mode.",
      "placeholder": "1985",
      "type": "number",
      "label": "Birth year",
      "default": "",
      "show_if": {
        "mode": "life-weeks"
      }
    },
    {
      "name": "life_expectancy_years",
      "unit": "years",
      "type": "number",
      "label": "Life expectancy",
      "default": 80,
      "show_if": {
        "mode": "life-weeks"
      },
      "help": "In years."
    },
    {
      "name": "show_percentage",
      "type": "boolean",
      "label": "Percentage",
      "default": true
    },
    {
      "name": "accent",
      "type": "select",
      "label": "Accent colour",
      "default": "terracotta",
      "choices": [
        {
          "value": "terracotta",
          "label": "Terracotta"
        },
        {
          "value": "ochre",
          "label": "Ochre"
        },
        {
          "value": "moss",
          "label": "Moss"
        },
        {
          "value": "teal",
          "label": "Teal"
        },
        {
          "value": "slate",
          "label": "Slate blue"
        }
      ]
    }
  ],
  "render": { "dither": "none", "needs_network": false }
}
