{
  "tesserae_compat": "1.x",
  "name": "News, RSS / Atom",
  "version": "0.3.1",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "Latest N headlines from any RSS 2.0 or Atom 1.0 feed. Paste a feed URL; the widget parses both formats with the stdlib XML parser (no extra deps).",
  "icon": "ph-rss",
  "category": "reading",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "url",
      "placeholder": "https://news.ycombinator.com/rss",
      "type": "string",
      "label": "Feed URL",
      "default": "https://news.ycombinator.com/rss"
    },
    {
      "name": "max_items",
      "type": "number",
      "label": "How many",
      "default": 8
    },
    {
      "name": "excerpt_lines",
      "type": "select",
      "label": "Article preview",
      "default": "0",
      "help": "Lines of the article summary to show under each headline, when the feed provides one. Off keeps the headline-only list.",
      "choices": [
        {
          "value": "0",
          "label": "Off"
        },
        {
          "value": "1",
          "label": "1 line"
        },
        {
          "value": "2",
          "label": "2 lines"
        },
        {
          "value": "3",
          "label": "3 lines"
        }
      ]
    },
    {
      "name": "show_source",
      "type": "boolean",
      "label": "Feed title",
      "default": true,
      "help": "The feed's title in the header."
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#C2410C",
    "fields": [
      {
        "name": "feed_title",
        "type": "str",
        "label": "Feed title"
      },
      {
        "name": "url",
        "type": "str",
        "label": "Feed URL"
      },
      {
        "name": "items",
        "type": "arr",
        "label": "Items"
      }
    ],
    "sample": {
      "feed_title": "Hacker News",
      "url": "https://news.ycombinator.com/rss",
      "items": [
        {
          "title": "A weekend with e-paper",
          "url": "https://example.com/1",
          "published": "2026-07-10T12:00:00"
        },
        {
          "title": "Rendering dashboards headless",
          "url": "https://example.com/2",
          "published": "2026-07-10T09:30:00"
        }
      ]
    }
  }
}
