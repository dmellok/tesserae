{
  "tesserae_compat": "1.x",
  "name": "Spotify — Now Playing",
  "version": "0.2.0",
  "kind": "widget",
  "description": "Currently-playing Spotify track — album art, title, artist, album and progress — in five selectable layouts (split / cover / minimal / vinyl / stack). Requires the Spotify Core plugin (connect your account at Plugins → Spotify).",
  "icon": "ph-music-notes",
  "supports": { "sizes": ["sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "variant",
      "type": "select",
      "label": "Layout",
      "default": "split",
      "choices": [
        { "value": "split", "label": "Split — art + text" },
        { "value": "cover", "label": "Cover — art hero" },
        { "value": "minimal", "label": "Minimal — text bar" },
        { "value": "vinyl", "label": "Vinyl — record" },
        { "value": "stack", "label": "Stack — big progress" }
      ]
    },
    { "name": "show_art", "type": "boolean", "label": "Show album art", "default": true },
    { "name": "show_album", "type": "boolean", "label": "Show album name", "default": true },
    { "name": "show_progress", "type": "boolean", "label": "Show progress bar", "default": true }
  ],
  "render": { "dither": "floyd-steinberg", "needs_network": true }
}
