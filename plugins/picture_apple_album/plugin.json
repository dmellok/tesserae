{
  "tesserae_compat": "1.x",
  "name": "Picture, Apple Shared Album",
  "version": "0.1.1",
  "kind": "widget",
  "description": "Rotates through photos in a public iCloud Shared Album, full bleed. Enable Public Website on the album in Photos, then paste its share link (https://www.icloud.com/sharedalbum/#B0xxxxxx) or just the token. NOTE: uses Apple's reverse-engineered shared-album endpoints, undocumented but stable for ~10 years.",
  "icon": "ph-cloud-arrow-down",
  "supports": { "sizes": ["sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "album",
      "type": "string",
      "label": "Album share link or token",
      "default": ""
    },
    {
      "name": "orientation",
      "type": "select",
      "label": "Orientation filter",
      "default": "any",
      "choices": [
        { "value": "any",       "label": "Any" },
        { "value": "portrait",  "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "square",    "label": "Square" }
      ]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Selection",
      "default": "random",
      "choices": [
        { "value": "random",     "label": "Random each render" },
        { "value": "sequential", "label": "Sequential (rotates one per render)" }
      ]
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Scale",
      "default": "fit",
      "choices": [
        { "value": "fit",     "label": "Fit (letterbox)" },
        { "value": "fill",    "label": "Fill (crop to cover)" },
        { "value": "stretch", "label": "Stretch (distort to fill)" },
        { "value": "blurred", "label": "Fit with blurred background" }
      ]
    },
    { "name": "show_caption", "type": "boolean", "label": "Show date + album-name overlay", "default": true },
    { "name": "show_sequence", "type": "boolean", "label": "Show sequence indicator (3 / 12)", "default": true }
  ],
  "render": { "dither": "floyd-steinberg", "needs_network": true, "full_bleed": true }
}
