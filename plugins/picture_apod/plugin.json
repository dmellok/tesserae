{
  "tesserae_compat": "1.x",
  "name": "Picture, NASA APOD",
  "version": "0.2.0",
  "kind": "widget",
  "locales": [
    "en",
    "cs",
    "de",
    "es",
    "fr",
    "it",
    "lt",
    "nb",
    "nl",
    "pl",
    "pt",
    "sk",
    "sv",
    "zh-CN",
    "zh-TW"
  ],
  "description": "NASA's Astronomy Picture of the Day, full bleed, from science.nasa.gov. Skips past video entries so the cell always shows an image. No API key needed.",
  "icon": "ph-planet",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "show_caption",
      "type": "boolean",
      "label": "Show title + copyright overlay",
      "default": true
    },
    {
      "name": "show_day_badge",
      "type": "boolean",
      "label": "Show day-of-month badge in the corner",
      "default": true
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Scale",
      "default": "fit",
      "choices": [
        {
          "value": "fit",
          "label": "Fit (letterbox)"
        },
        {
          "value": "fill",
          "label": "Fill (crop to cover)"
        },
        {
          "value": "stretch",
          "label": "Stretch (distort to fill)"
        },
        {
          "value": "blurred",
          "label": "Fit with blurred background"
        }
      ]
    }
  ],
  "render": {
    "dither": "floyd-steinberg",
    "needs_network": true,
    "full_bleed": true
  },
  "data_schema": {
    "color": "#3F2A6B",
    "fields": [
      {
        "name": "title",
        "type": "str",
        "label": "Title"
      },
      {
        "name": "date",
        "type": "str",
        "label": "Date"
      },
      {
        "name": "copyright",
        "type": "str",
        "label": "Credit"
      },
      {
        "name": "url",
        "type": "str",
        "label": "Image URL"
      },
      {
        "name": "permalink",
        "type": "str",
        "label": "Article link"
      }
    ],
    "sample": {
      "title": "Supernumerary Rainbows over New Jersey",
      "date": "2026-10-04",
      "copyright": "John Entwistle",
      "url": "https://assets.science.nasa.gov/dynamicimage/assets/science/cds/apod/apod/2026/october/SupernumeraryRainbows_Entwistle_1362.jpg?w=1200&h=1200&fit=clip",
      "permalink": "https://science.nasa.gov/image-article/apod-2026-october-4-supernumerary-rainbows-over-new-jersey/"
    }
  }
}
