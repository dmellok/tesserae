{
  "tesserae_compat": "1.x",
  "name": "Calendar, Day",
  "version": "0.2.2",
  "kind": "widget",
  "description": "Today's agenda Reads from feeds configured in Widgets \u2192 Calendar Feeds; each feed's colour drives the stripe / marker / fill colour.",
  "icon": "ph-calendar-check",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "hours_ahead",
      "type": "number",
      "label": "Hours of agenda to show",
      "default": 24
    },
    {
      "name": "max_events",
      "type": "number",
      "label": "Max events (0 = all)",
      "default": 0
    },
    {
      "name": "feeds_filter",
      "type": "string",
      "label": "Feed IDs (comma-separated; blank = all enabled)",
      "default": ""
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#4F6F36",
    "fields": [
      {
        "name": "date",
        "type": "str",
        "label": "Date"
      },
      {
        "name": "count",
        "type": "num",
        "label": "Event count"
      },
      {
        "name": "events",
        "type": "arr",
        "label": "Events"
      }
    ],
    "sample": {
      "date": "2026-07-10",
      "count": 3,
      "events": [
        {
          "summary": "Standup",
          "start": "2026-07-10T09:30:00",
          "all_day": false,
          "location": "Zoom"
        },
        {
          "summary": "Lunch with Sam",
          "start": "2026-07-10T12:30:00",
          "all_day": false,
          "location": ""
        },
        {
          "summary": "Dentist",
          "start": "2026-07-10T16:00:00",
          "all_day": false,
          "location": "High St"
        }
      ]
    }
  }
}
