{
  "tesserae_compat": "1.x",
  "name": "Calendar — Day",
  "version": "0.1.0",
  "kind": "widget",
  "description": "Today's agenda — chronological list of events with time, summary, location, and a colour stripe per feed. Reads from feeds configured in Plugins → Calendar Feeds.",
  "icon": "ph-calendar-check",
  "supports": { "sizes": ["xs", "sm", "md", "lg"] },
  "cell_options": [
    { "name": "hours_ahead",  "type": "number", "label": "Hours of agenda to show",                "default": 24 },
    { "name": "max_events",   "type": "number", "label": "Max events (0 = all)",                   "default": 0 },
    { "name": "feeds_filter", "type": "string", "label": "Feed IDs (comma-separated; blank = all enabled)", "default": "" }
  ],
  "render": { "dither": "none", "needs_network": true }
}
