{
  "tesserae_compat": "1.x",
  "name": "Home Assistant — Camera",
  "version": "0.1.2",
  "kind": "widget",
  "description": "Snapshot from one or more Home Assistant camera.* entities. Pulls each entity's entity_picture via HA's REST API and renders it as a still frame — perfect for a door cam, garden cam, or 2×2 grid of indoor cameras on an e-ink display.",
  "icon": "ph-video-camera",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "entity_id",
      "type": "select",
      "label": "Camera entity",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "entities",
      "type": "multiselect",
      "label": "Extra cameras (optional grid)",
      "default": [],
      "choices_from": "entity"
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label",
      "default": "Camera"
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
