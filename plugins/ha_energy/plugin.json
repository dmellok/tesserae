{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, Energy",
  "version": "0.3.0",
  "kind": "widget",
  "description": "Live solar / grid / battery / house-consumption snapshot from your HA energy dashboard, with today's totals and a 24-hour sparkline. Wires to the same sensor.* entities you've already configured under HA's Energy panel.",
  "icon": "ph-lightning",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "solar_entity",
      "type": "select",
      "label": "Solar power entity",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "grid_entity",
      "type": "select",
      "label": "Grid power entity (+ import / − export)",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "battery_entity",
      "type": "select",
      "label": "Battery power entity (+ charge / − discharge)",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "house_entity",
      "type": "select",
      "label": "House consumption entity",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "battery_soc_entity",
      "type": "select",
      "label": "Battery SoC entity (optional)",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "solar_today_entity",
      "type": "select",
      "label": "Solar energy today (kWh) entity (optional)",
      "default": "",
      "choices_from": "entity"
    },
    {
      "name": "label",
      "type": "string",
      "label": "Place label",
      "default": "Home"
    }
  ],
  "fragments": [
    { "id": "full", "label": "Full card", "w": 320, "h": 260, "icon": "ph-lightning" },
    { "id": "sankey", "label": "Flow diagram", "w": 300, "h": 200, "icon": "ph-flow-arrow" },
    { "id": "trend", "label": "Today vs yesterday", "w": 300, "h": 90, "icon": "ph-chart-line" },
    { "id": "stats", "label": "Battery + solar", "w": 200, "h": 90, "icon": "ph-battery-charging" }
  ],
  "render": {
    "dither": "none",
    "needs_network": false
  }
}
