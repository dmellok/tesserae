{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, Heat Pump",
  "version": "0.1.0",
  "kind": "widget",
  "description": "Heat-pump compressor status, temperatures, and electricity consumption from Home Assistant.",
  "icon": "ph-thermometer-hot",
  "category": "home-assistant",
  "locales": ["en", "de"],
  "supports": {
    "sizes": ["xs", "sm", "md", "lg"]
  },
  "fragments": [
    { "id": "full", "label": "Full widget", "w": 396, "h": 256, "icon": "ph-fan" },
    { "id": "compressor", "label": "Compressor status", "w": 220, "h": 128, "icon": "ph-fan" },
    { "id": "heating", "label": "Heating temperature", "w": 220, "h": 120, "icon": "ph-thermometer-simple" },
    { "id": "hot_water", "label": "Hot-water temperature", "w": 220, "h": 120, "icon": "ph-drop" },
    { "id": "current_power", "label": "Current consumption", "w": 220, "h": 110, "icon": "ph-lightning" },
    { "id": "total_energy", "label": "Total energy", "w": 220, "h": 120, "icon": "ph-lightning" },
    { "id": "heating_energy", "label": "Heating energy", "w": 220, "h": 120, "icon": "ph-thermometer-simple" },
    { "id": "hot_water_energy", "label": "Hot-water energy", "w": 220, "h": 120, "icon": "ph-drop" }
  ],
  "cell_options": [
    {
      "name": "compressor_entity",
      "type": "select",
      "label": "Compressor status",
      "default": "",
      "choices_from": "binary_sensor"
    },
    {
      "name": "flow_entity",
      "type": "select",
      "label": "Heating temperature",
      "default": "",
      "choices_from": "sensor"
    },
    {
      "name": "show_heating",
      "type": "boolean",
      "label": "Show heating panel",
      "default": true
    },
    {
      "name": "hot_water_temperature_entity",
      "type": "select",
      "label": "Hot-water temperature",
      "default": "",
      "choices_from": "sensor"
    },
    {
      "name": "show_hot_water",
      "type": "boolean",
      "label": "Show hot-water panel",
      "default": true
    },
    {
      "name": "show_yesterday",
      "type": "boolean",
      "label": "Show yesterday's energy",
      "default": true,
      "advanced": true
    },
    {
      "name": "show_temperature_gauge",
      "type": "boolean",
      "label": "Show temperature gauge",
      "default": false,
      "advanced": true
    },
    {
      "name": "power_entity",
      "type": "select",
      "label": "Current energy consumption",
      "default": "",
      "choices_from": "sensor",
      "advanced": true
    },
    {
      "name": "heating_entity",
      "type": "select",
      "label": "Heating climate entity",
      "default": "",
      "choices_from": "heating",
      "advanced": true,
      "help": "Used as a fallback if the heating temperature sensor is unavailable."
    },
    {
      "name": "hot_water_entity",
      "type": "select",
      "label": "Hot-water entity",
      "default": "",
      "choices_from": "hot_water",
      "advanced": true,
      "help": "Used as a fallback if the hot-water temperature sensor is unavailable."
    },
    {
      "name": "daily_energy_entity",
      "type": "select",
      "label": "Total daily electricity",
      "default": "",
      "choices_from": "sensor",
      "advanced": true
    },
    {
      "name": "heating_energy_entity",
      "type": "select",
      "label": "Heating daily electricity",
      "default": "",
      "choices_from": "sensor",
      "advanced": true
    },
    {
      "name": "hot_water_energy_entity",
      "type": "select",
      "label": "Hot-water daily electricity",
      "default": "",
      "choices_from": "sensor",
      "advanced": true
    },
    {
      "name": "overall_spf_entity",
      "type": "select",
      "label": "Overall seasonal performance",
      "default": "",
      "choices_from": "sensor",
      "advanced": true
    },
    {
      "name": "show_overall_spf",
      "type": "boolean",
      "label": "Show overall SPF",
      "default": true,
      "advanced": true
    },
    {
      "name": "label",
      "type": "string",
      "label": "Title",
      "default": "Heat pump",
      "advanced": true
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": false
  }
}
