{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, History",
  "version": "0.3.1",
  "kind": "widget",
  "description": "A numeric Home Assistant sensor over time. Pairs the current value + trend arrow + min/max with a Chart.js line chart, optional threshold horizontal line, min/max marker dots + labels on the curve, and an averaged hourly-profile ghost overlay for long windows. Requires the Home Assistant Core plugin.",
  "icon": "ph-chart-line",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "title",
      "type": "string",
      "label": "Title (blank = entity name / \"History\")",
      "default": ""
    },
    {
      "name": "entities",
      "type": "multiselect",
      "label": "Entities",
      "default": [],
      "choices_from": "entity"
    },
    {
      "name": "threshold",
      "type": "number",
      "label": "Threshold (optional)",
      "default": "",
      "help": "Draws a horizontal dashed line at this value. Useful for 'too cold' / 'too high' / 'over budget' thresholds."
    },
    {
      "name": "show_min_max",
      "type": "boolean",
      "label": "Mark min / max points on the chart",
      "default": true
    },
    {
      "name": "show_profile",
      "type": "boolean",
      "label": "Show averaged hourly-profile overlay (long windows)",
      "default": true
    },
    {
      "name": "window",
      "type": "select",
      "label": "Time window",
      "default": "24",
      "choices": [
        {
          "value": "6",
          "label": "Last 6 hours"
        },
        {
          "value": "12",
          "label": "Last 12 hours"
        },
        {
          "value": "24",
          "label": "Last 24 hours"
        },
        {
          "value": "72",
          "label": "Last 3 days"
        },
        {
          "value": "168",
          "label": "Last week"
        },
        {
          "value": "336",
          "label": "Last 2 weeks"
        },
        {
          "value": "720",
          "label": "Last month"
        },
        {
          "value": "2160",
          "label": "Last 3 months"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
