{
  "tesserae_compat": "1.x",
  "name": "Weather, Hourly",
  "version": "0.2.5",
  "kind": "widget",
  "description": "Hourly temperature line with a shaded area + condition-icon strip across the top. Defaults to the next 12 hours; configurable to 24 or 48. Data from Open-Meteo (no API key).",
  "icon": "ph-chart-line",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Location",
      "default": "",
      "help": "Search a city to set the location. The latitude / longitude that drive the weather data come from the picked result; the Label below auto-fills with the city name."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label",
      "default": "",
      "help": "Auto-filled from the location pick; edit to customise (e.g. 'Home' instead of 'Berlin')."
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (°C)"
        },
        {
          "value": "imperial",
          "label": "Imperial (°F)"
        }
      ]
    },
    {
      "name": "hours",
      "type": "select",
      "label": "Window",
      "default": "12",
      "choices": [
        {
          "value": "12",
          "label": "12 hours"
        },
        {
          "value": "24",
          "label": "24 hours"
        },
        {
          "value": "48",
          "label": "48 hours"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#9A7414",
    "fields": [
      {
        "name": "place",
        "type": "str",
        "label": "Place"
      },
      {
        "name": "time",
        "type": "str",
        "label": "Time"
      },
      {
        "name": "units",
        "type": "str",
        "label": "Units"
      },
      {
        "name": "now",
        "type": "num",
        "label": "Now",
        "unit": "deg"
      },
      {
        "name": "hi",
        "type": "num",
        "label": "High",
        "unit": "deg"
      },
      {
        "name": "lo",
        "type": "num",
        "label": "Low",
        "unit": "deg"
      },
      {
        "name": "temps",
        "type": "arr",
        "label": "Temperatures"
      },
      {
        "name": "rain",
        "type": "arr",
        "label": "Rain chance"
      },
      {
        "name": "hours",
        "type": "arr",
        "label": "Hours"
      }
    ],
    "sample": {
      "place": "Melbourne",
      "time": "14:00",
      "units": "metric",
      "now": 19,
      "hi": 22,
      "lo": 14,
      "temps": [
        19,
        20,
        21,
        21,
        20,
        18
      ],
      "rain": [
        0,
        10,
        20,
        20,
        10,
        0
      ],
      "hours": [
        {
          "t": "14:00",
          "icon": "sun"
        },
        {
          "t": "15:00",
          "icon": "cloud-sun"
        },
        {
          "t": "16:00",
          "icon": "cloud"
        }
      ]
    }
  }
}
