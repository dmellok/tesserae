{
  "tesserae_compat": "1.x",
  "name": "Weather \u2014 Hourly",
  "version": "0.1.1",
  "kind": "widget",
  "description": "Next-24-hours temperature curve with a rain-probability strip. Data from Open-Meteo (no API key). Renders via Chart.js for a smooth, theme-coloured curve.",
  "icon": "ph-chart-line",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "latitude",
      "type": "number",
      "label": "Latitude",
      "default": ""
    },
    {
      "name": "longitude",
      "type": "number",
      "label": "Longitude",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "label": "Place label",
      "default": "Melbourne"
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (\u00b0C)"
        },
        {
          "value": "imperial",
          "label": "Imperial (\u00b0F)"
        }
      ]
    },
    {
      "name": "hours",
      "type": "select",
      "label": "Window",
      "default": "24",
      "choices": [
        {
          "value": "12",
          "label": "12 hours"
        },
        {
          "value": "24",
          "label": "24 hours"
        },
        {
          "value": "48",
          "label": "48 hours"
        }
      ]
    },
    {
      "name": "variant",
      "type": "select",
      "label": "Style",
      "default": "legacy",
      "choices": [
        {
          "value": "legacy",
          "label": "Legacy"
        },
        {
          "value": "r1",
          "label": "1 \u00b7 Refined"
        },
        {
          "value": "g2",
          "label": "2 \u00b7 Geometric"
        },
        {
          "value": "s3",
          "label": "3 \u00b7 Swiss"
        },
        {
          "value": "d4",
          "label": "4 \u00b7 Data"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
