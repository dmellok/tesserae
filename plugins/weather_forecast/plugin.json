{
  "tesserae_compat": "1.x",
  "name": "Weather \u2014 Forecast",
  "version": "0.1.0",
  "kind": "widget",
  "description": "5-day forecast as a row of theme-aware cards: day name, condition icon, high / low temps, and rain probability. Data from Open-Meteo (no API key).",
  "icon": "ph-calendar-dots",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "latitude",
      "type": "number",
      "label": "Latitude",
      "default": ""
    },
    {
      "name": "longitude",
      "type": "number",
      "label": "Longitude",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "label": "Place label",
      "default": "Melbourne"
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (\u00b0C)"
        },
        {
          "value": "imperial",
          "label": "Imperial (\u00b0F)"
        }
      ]
    },
    {
      "name": "variant",
      "type": "select",
      "label": "Style",
      "default": "legacy",
      "choices": [
        {
          "value": "legacy",
          "label": "Legacy"
        },
        {
          "value": "r1",
          "label": "1 \u00b7 Refined"
        },
        {
          "value": "g2",
          "label": "2 \u00b7 Geometric"
        },
        {
          "value": "s3",
          "label": "3 \u00b7 Swiss"
        },
        {
          "value": "d4",
          "label": "4 \u00b7 Data"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
