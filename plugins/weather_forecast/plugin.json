{
  "tesserae_compat": "1.x",
  "name": "Weather, Forecast",
  "version": "0.1.8",
  "kind": "widget",
  "description": "5-day forecast as a row of theme-aware cards: day name, condition icon, high / low temps, and rain probability. Data from Open-Meteo (no API key).",
  "icon": "ph-calendar-dots",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Location",
      "default": "",
      "help": "Search a city to set the location. The latitude / longitude that drive the weather data come from the picked result; the Label below auto-fills with the city name."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label",
      "default": "",
      "help": "Auto-filled from the location pick; edit to customise (e.g. 'Home' instead of 'Berlin')."
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (°C)"
        },
        {
          "value": "imperial",
          "label": "Imperial (°F)"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#9A7414",
    "fields": [
      {
        "name": "place",
        "type": "str",
        "label": "Place"
      },
      {
        "name": "time",
        "type": "str",
        "label": "Time"
      },
      {
        "name": "units",
        "type": "str",
        "label": "Units"
      },
      {
        "name": "rangeHi",
        "type": "num",
        "label": "Week high",
        "unit": "deg"
      },
      {
        "name": "rangeLo",
        "type": "num",
        "label": "Week low",
        "unit": "deg"
      },
      {
        "name": "days",
        "type": "arr",
        "label": "Days"
      }
    ],
    "sample": {
      "place": "Melbourne",
      "time": "14:32",
      "units": "metric",
      "rangeHi": 24,
      "rangeLo": 9,
      "days": [
        {
          "day": "Mon",
          "icon": "sun",
          "cond": "Sunny",
          "hi": 24,
          "lo": 12,
          "rain": 10,
          "today": true
        },
        {
          "day": "Tue",
          "icon": "cloud",
          "cond": "Cloudy",
          "hi": 20,
          "lo": 11,
          "rain": 40,
          "today": false
        },
        {
          "day": "Wed",
          "icon": "cloud-rain",
          "cond": "Showers",
          "hi": 17,
          "lo": 9,
          "rain": 70,
          "today": false
        }
      ]
    }
  }
}
