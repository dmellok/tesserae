{
  "tesserae_compat": "1.x",
  "name": "Calendar — Week",
  "version": "0.2.0",
  "kind": "widget",
  "description": "Seven-day strip — six Bauhaus / Swiss visual directions to choose from. Each event's colour comes from its feed (Plugins → Calendar Feeds).",
  "icon": "ph-calendar",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "week_start",
      "type": "select",
      "label": "Week starts on",
      "default": "monday",
      "choices": [
        {
          "value": "sunday",
          "label": "Sunday"
        },
        {
          "value": "monday",
          "label": "Monday"
        }
      ]
    },
    {
      "name": "feeds_filter",
      "type": "string",
      "label": "Feed IDs (comma-separated; blank = all enabled)",
      "default": ""
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
