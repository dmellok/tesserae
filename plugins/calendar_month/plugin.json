{
  "tesserae_compat": "1.x",
  "name": "Calendar, Month",
  "version": "0.2.2",
  "kind": "widget",
  "description": "Month-grid view Reads from feeds configured in Widgets \u2192 Calendar Feeds; each feed's colour drives the bar / dot / stripe colour.",
  "icon": "ph-calendar",
  "supports": {
    "sizes": [
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "week_start",
      "type": "select",
      "label": "Week starts on",
      "default": "monday",
      "choices": [
        {
          "value": "sunday",
          "label": "Sunday"
        },
        {
          "value": "monday",
          "label": "Monday"
        }
      ]
    },
    {
      "name": "max_events_per_day",
      "type": "number",
      "label": "Max event chips per day",
      "default": 3
    },
    {
      "name": "event_display",
      "type": "select",
      "label": "Event style",
      "default": "bars",
      "choices": [
        {
          "value": "bars",
          "label": "Coloured bars"
        },
        {
          "value": "text",
          "label": "Title text with feed colour bar"
        }
      ]
    },
    {
      "name": "heatmap",
      "type": "boolean",
      "label": "Heat-tint busy days",
      "default": true
    },
    {
      "name": "feeds_filter",
      "type": "string",
      "label": "Feed IDs (comma-separated; blank = all enabled)",
      "default": ""
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#4F6F36",
    "fields": [
      {
        "name": "month",
        "type": "num",
        "label": "Month"
      },
      {
        "name": "year",
        "type": "num",
        "label": "Year"
      },
      {
        "name": "month_name",
        "type": "str",
        "label": "Month name"
      },
      {
        "name": "days",
        "type": "arr",
        "label": "Days"
      }
    ],
    "sample": {
      "month": 7,
      "year": 2026,
      "month_name": "July",
      "days": [
        {
          "date": "2026-07-10",
          "day": 10,
          "in_month": true,
          "is_today": true,
          "events": [],
          "total": 2,
          "extra": 0
        },
        {
          "date": "2026-07-11",
          "day": 11,
          "in_month": true,
          "is_today": false,
          "events": [],
          "total": 0,
          "extra": 0
        }
      ]
    }
  }
}
