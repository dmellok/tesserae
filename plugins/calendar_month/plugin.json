{
  "tesserae_compat": "1.x",
  "name": "Calendar — Month",
  "version": "0.2.0",
  "kind": "widget",
  "description": "Month-grid view Reads from feeds configured in Plugins → Calendar Feeds; each feed's colour drives the bar / dot / stripe colour.",
  "icon": "ph-calendar",
  "supports": {
    "sizes": [
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "week_start",
      "type": "select",
      "label": "Week starts on",
      "default": "monday",
      "choices": [
        {
          "value": "sunday",
          "label": "Sunday"
        },
        {
          "value": "monday",
          "label": "Monday"
        }
      ]
    },
    {
      "name": "max_events_per_day",
      "type": "number",
      "label": "Max event chips per day",
      "default": 3
    },
    {
      "name": "event_display",
      "type": "select",
      "label": "Event style",
      "default": "bars",
      "choices": [
        {
          "value": "bars",
          "label": "Coloured bars"
        },
        {
          "value": "text",
          "label": "Title text with feed colour bar"
        }
      ]
    },
    {
      "name": "feeds_filter",
      "type": "string",
      "label": "Feed IDs (comma-separated; blank = all enabled)",
      "default": ""
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
