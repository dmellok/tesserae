{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, Batteries",
  "version": "0.1.4",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "Auto-discovered battery levels across every Home Assistant entity with device_class=battery, sorted lowest-first. Picks up phones, sensors, vacuums, remotes, anything HA already exposes as a battery, and flags low/critical against per-cell thresholds.",
  "icon": "ph-battery-low",
  "category": "home-assistant",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "entities",
      "type": "multiselect",
      "label": "Batteries",
      "default": [],
      "choices_from": "entity",
      "help": "Blank finds every battery."
    },
    {
      "name": "limit",
      "type": "number",
      "label": "How many",
      "default": 12
    },
    {
      "name": "low_threshold",
      "unit": "%",
      "type": "number",
      "label": "Low at",
      "default": 20,
      "help": "Percent."
    },
    {
      "name": "critical_threshold",
      "unit": "%",
      "type": "number",
      "label": "Critical at",
      "default": 10,
      "help": "Percent."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Title",
      "default": "Batteries"
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": false
  }
}
