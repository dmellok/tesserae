{
  "tesserae_compat": "1.x",
  "name": "Weather, Scenic",
  "version": "0.1.2",
  "kind": "widget",
  "description": "Current weather as a pill card with weather-and-time-of-day theming. Uses the extended palette opt-in so soft gradients (sunset, night sky) render on 7-colour e-ink panels via the renderer's dither pass. Data from Open-Meteo (no API key).",
  "icon": "ph-cloud-sun",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Location",
      "default": "",
      "help": "Search a city to set the location. The latitude / longitude that drive the weather data come from the picked result; the Label below auto-fills with the city name."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label",
      "default": "",
      "help": "Auto-filled from the location pick; edit to customise (e.g. 'Home' instead of 'Berlin')."
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (\u00b0C)"
        },
        {
          "value": "imperial",
          "label": "Imperial (\u00b0F)"
        }
      ]
    }
  ],
  "render": {
    "needs_network": true
  },
  "requires": [
    "network:api.open-meteo.com"
  ],
  "design": {
    "palette": "extended"
  },
  "data_schema": {
    "color": "#9A7414",
    "fields": [
      {
        "name": "label",
        "type": "str",
        "label": "Place"
      },
      {
        "name": "units",
        "type": "str",
        "label": "Units"
      },
      {
        "name": "temp",
        "type": "num",
        "label": "Temperature",
        "unit": "deg"
      },
      {
        "name": "cond",
        "type": "str",
        "label": "Condition"
      },
      {
        "name": "icon",
        "type": "str",
        "label": "Icon"
      },
      {
        "name": "preset",
        "type": "str",
        "label": "Scene"
      },
      {
        "name": "sunrise",
        "type": "str",
        "label": "Sunrise"
      },
      {
        "name": "sunset",
        "type": "str",
        "label": "Sunset"
      }
    ],
    "sample": {
      "label": "Melbourne",
      "units": "metric",
      "temp": 19,
      "cond": "Partly cloudy",
      "icon": "cloud-sun",
      "preset": "day",
      "sunrise": "07:12",
      "sunset": "17:38"
    }
  }
}
