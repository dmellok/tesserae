{
  "tesserae_compat": "1.x",
  "name": "Todo",
  "version": "0.1.0",
  "kind": "widget",
  "description": "Persistent todo lists. Create lists and add items on the admin page (Plugins → Todo); the widget cell renders the chosen list as a read-only checklist. Completed items auto-prune after 24 hours so the list doesn't grow indefinitely.",
  "icon": "ph-list-checks",
  "supports": { "sizes": ["xs", "sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "list_id",
      "type": "select",
      "label": "List",
      "choices_from": "lists"
    },
    {
      "name": "show_completed",
      "type": "boolean",
      "label": "Show recently-completed items (last 24h)",
      "default": true
    },
    {
      "name": "max_items",
      "type": "number",
      "label": "Max items shown (0 = all)",
      "default": 0
    }
  ],
  "render": { "dither": "none", "needs_network": false }
}
