{
  "tesserae_compat": "1.x",
  "name": "News, Wikipedia On This Day",
  "version": "0.2.4",
  "kind": "widget",
  "description": "Wikipedia 'On this day', featured historical events for today's date. Uses the free Wikimedia REST API (no key).",
  "icon": "ph-book-open",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "type",
      "type": "select",
      "label": "Type",
      "default": "events",
      "choices": [
        {
          "value": "events",
          "label": "Events"
        },
        {
          "value": "births",
          "label": "Births"
        },
        {
          "value": "deaths",
          "label": "Deaths"
        },
        {
          "value": "holidays",
          "label": "Holidays"
        }
      ]
    },
    {
      "name": "max_items",
      "type": "number",
      "label": "Max entries",
      "default": 6
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#C2410C",
    "fields": [
      {
        "name": "kind",
        "type": "str",
        "label": "Kind"
      },
      {
        "name": "date",
        "type": "str",
        "label": "Date"
      },
      {
        "name": "items",
        "type": "arr",
        "label": "Items"
      }
    ],
    "sample": {
      "kind": "events",
      "date": "10 July",
      "items": [
        {
          "year": 1962,
          "text": "Telstar relayed the first live transatlantic television signal.",
          "page": "Telstar"
        },
        {
          "year": 1913,
          "text": "Death Valley recorded 56.7 C, the highest reliably measured air temperature.",
          "page": "Death Valley"
        }
      ]
    }
  }
}
