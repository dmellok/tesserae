{
  "tesserae_compat": "1.x",
  "name": "Core themes",
  "version": "0.8.0",
  "kind": "theme",
  "description": "Curated theme set in three families. Ten light + ten dark variants share the Ramen design DNA — warm undertones, dusty muted accents, papery flat surfaces (surface == bg). Five neon dark themes break the rules deliberately for synthwave/cyberpunk dashboards. Each theme picks three coherent decorative tokens — accent / accent2 / accent3 — that the widgets paint with for colour-blocked layouts. warn / danger / ok stay reserved for actual semantic states (errors, warnings, success badges) and never appear in regular UI. User themes save under data/plugins/themes_core/user.json.",
  "supports": {
    "sizes": ["xs", "sm", "md", "lg"]
  },
