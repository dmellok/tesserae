{
  "tesserae_compat": "1.x",
  "name": "Weather, Now",
  "version": "0.1.10",
  "kind": "widget",
  "description": "Current conditions plus feels-like, humidity, wind, UV and sun times. Data from Open-Meteo (no API key required).",
  "icon": "ph-cloud-sun",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Location",
      "default": "",
      "help": "Search a city to set the location. The latitude / longitude that drive the weather data come from the picked result; the Label below auto-fills with the city name."
    },
    {
      "name": "label",
      "type": "string",
      "label": "Label",
      "default": "",
      "help": "Auto-filled from the location pick; edit to customise (e.g. 'Home' instead of 'Berlin')."
    },
    {
      "name": "units",
      "type": "select",
      "label": "Units",
      "default": "metric",
      "choices": [
        {
          "value": "metric",
          "label": "Metric (\u00b0C, km/h)"
        },
        {
          "value": "imperial",
          "label": "Imperial (\u00b0F, mph)"
        }
      ]
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "requires": [
    "network:api.open-meteo.com"
  ],
  "data_schema": {
    "color": "#9A7414",
    "fields": [
      { "name": "temp", "type": "num", "label": "Temperature", "unit": "deg" },
      { "name": "feels", "type": "num", "label": "Feels like", "unit": "deg" },
      { "name": "humidity", "type": "num", "label": "Humidity", "unit": "%" },
      { "name": "wind", "type": "num", "label": "Wind", "unit": "km/h" },
      { "name": "uv", "type": "num", "label": "UV index" },
      { "name": "high", "type": "num", "label": "High", "unit": "deg" },
      { "name": "low", "type": "num", "label": "Low", "unit": "deg" },
      { "name": "rain_chance", "type": "num", "label": "Rain chance", "unit": "%" },
      { "name": "cond", "type": "str", "label": "Condition" },
      { "name": "icon", "type": "str", "label": "Condition icon" }
    ],
    "sample": {
      "temp": 21, "feels": 22, "humidity": 62, "wind": 13, "uv": 4,
      "high": 24, "low": 15, "rain_chance": 10,
      "cond": "Partly cloudy", "icon": "cloud-sun"
    }
  }
}
