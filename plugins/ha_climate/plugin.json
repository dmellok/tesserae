{
  "tesserae_compat": "1.x",
  "name": "Home Assistant, Climate",
  "version": "0.4.1",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "One or more Home Assistant climate / thermostat entities Each entity tints by what the thermostat is doing right now (heating / cooling / idle). Requires the Home Assistant Core plugin.",
  "icon": "ph-thermometer-simple",
  "category": "home-assistant",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "entities",
      "type": "multiselect",
      "label": "Climate entities",
      "default": [],
      "choices_from": "entity"
    },
    {
      "name": "title",
      "placeholder": "Living room climate",
      "type": "string",
      "label": "Title",
      "default": "",
      "help": "Blank uses the entity name, or Climate for several."
    }
  ],
  "fragments": [
    { "id": "full", "label": "Full card", "w": 300, "h": 200, "icon": "ph-thermometer-simple" },
    { "id": "dial", "label": "Thermostat dial", "w": 180, "h": 180, "icon": "ph-gauge" },
    { "id": "chips", "label": "Mode + humidity", "w": 200, "h": 100, "icon": "ph-fan" }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  }
}
