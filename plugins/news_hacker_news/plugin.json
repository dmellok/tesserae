{
  "tesserae_compat": "1.x",
  "name": "News, Hacker News",
  "version": "0.2.2",
  "kind": "widget",
  "description": "Top / new / best / show / ask stories from Hacker News. Uses the free Firebase API (no auth, no key). Click-through opens the story; the lightbox doesn't apply.",
  "icon": "ph-flame",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "feed",
      "type": "select",
      "label": "Feed",
      "default": "top",
      "choices": [
        {
          "value": "top",
          "label": "Top stories"
        },
        {
          "value": "new",
          "label": "New stories"
        },
        {
          "value": "best",
          "label": "Best stories"
        },
        {
          "value": "show",
          "label": "Show HN"
        },
        {
          "value": "ask",
          "label": "Ask HN"
        }
      ]
    },
    {
      "name": "max_items",
      "type": "number",
      "label": "Max stories",
      "default": 10
    }
  ],
  "render": {
    "dither": "none",
    "needs_network": true
  },
  "data_schema": {
    "color": "#C2410C",
    "fields": [
      {
        "name": "feed",
        "type": "str",
        "label": "Feed"
      },
      {
        "name": "stories",
        "type": "arr",
        "label": "Stories"
      }
    ],
    "sample": {
      "feed": "top",
      "stories": [
        {
          "title": "Show HN: A self-hosted e-ink dashboard",
          "by": "kayden",
          "score": 214,
          "comments": 88,
          "url": "https://news.ycombinator.com/item?id=1"
        },
        {
          "title": "Ask HN: Favourite low-power displays?",
          "by": "areader",
          "score": 98,
          "comments": 41,
          "url": "https://news.ycombinator.com/item?id=2"
        },
        {
          "title": "The quiet joy of paper-like screens",
          "by": "writer",
          "score": 76,
          "comments": 33,
          "url": "https://news.ycombinator.com/item?id=3"
        }
      ]
    }
  }
}
