{
  "tesserae_compat": "1.x",
  "name": "Core fonts",
  "version": "0.6.0",
  "kind": "font",
  "description": "Curated open-source font set vendored locally, 39 families. Modern + accessible sans, geometric, display, serif, plus a broad monospace / programming set (JetBrains Mono, IBM Plex Mono, Space Mono, Fira Code, Source Code Pro, Martian Mono, Red Hat Mono, Fragment Mono, Spline Sans Mono, Overpass Mono) and pixel / bitmap fonts (Press Start 2P, VT323, Silkscreen, Pixelify Sans, Handjet, Micro 5, DotGothic16, Jersey 10 / 25, TRMNL12 / 16 / 21). TRMNL12 / 16 / 21 are drawn on a pixel grid at 12px, 16px and 21px, so set them at that size or an integer multiple to stay crisp. Latin, woff2, OFL/Apache.",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
