{
  "tesserae_compat": "1.x",
  "name": "OctoPrint, Status",
  "version": "0.1.3",
  "kind": "widget",
  "description": "Live 3D-print monitor for an OctoPrint instance: printer state, job progress with ETA, and hotend/bed temperatures.",
  "icon": "ph-printer",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "label",
      "type": "string",
      "label": "Title",
      "default": "OctoPrint"
    }
  ],
  "settings": [
    {
      "name": "base_url",
      "type": "string",
      "label": "OctoPrint URL",
      "default": "http://octopi.local"
    },
    {
      "name": "api_key",
      "type": "string",
      "label": "API key",
      "secret": true
    }
  ],
  "render": {
    "needs_network": true
  }
}
