{
  "tesserae_compat": "1.x",
  "name": "Picture, Gallery",
  "version": "0.1.4",
  "kind": "widget",
  "locales": ["en", "cs", "de", "es", "fr", "it", "lt", "nb", "nl", "pl", "pt", "sk", "sv", "zh-CN", "zh-TW"],
  "description": "Folder-based image rotation, full bleed. Manage folders + uploads at Widgets → Gallery. Supports internal folders (uploaded to the appliance) and external pointers to any directory on the host. Optional orientation filter + random or sequential rotation.",
  "icon": "ph-images",
  "category": "art",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "cell_options": [
    {
      "name": "folder",
      "type": "select",
      "label": "Folder",
      "default": "",
      "choices_from": "folders"
    },
    {
      "name": "orientation",
      "type": "select",
      "label": "Orientation",
      "default": "any",
      "choices": [
        {
          "value": "any",
          "label": "Any"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "help": "Only pictures of this shape."
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Order",
      "default": "random",
      "choices": [
        {
          "value": "random",
          "label": "Random each render"
        },
        {
          "value": "sequential",
          "label": "Sequential (rotates one per render)"
        }
      ]
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Scale",
      "default": "fit",
      "choices": [
        {
          "value": "fit",
          "label": "Fit (letterbox)"
        },
        {
          "value": "fill",
          "label": "Fill (crop to cover)"
        },
        {
          "value": "stretch",
          "label": "Stretch (distort to fill)"
        },
        {
          "value": "center",
          "label": "Center (no scaling)"
        },
        {
          "value": "blurred",
          "label": "Fit with blurred background"
        }
      ]
    },
    {
      "name": "show_filename",
      "type": "boolean",
      "label": "Filename",
      "default": false,
      "advanced": true,
      "help": "The picture's filename over the image."
    },
    {
      "name": "show_folder_chip",
      "type": "boolean",
      "label": "Folder name",
      "default": true,
      "advanced": true,
      "help": "The folder's name in a corner chip."
    },
    {
      "name": "show_count",
      "type": "boolean",
      "label": "Photo count",
      "default": true,
      "advanced": true,
      "help": "A photo count indicator."
    }
  ],
  "lineups": {
    "draw": true
  },
  "render": {
    "dither": "floyd-steinberg",
    "full_bleed": true,
    "per_device_id": true
  }
}
