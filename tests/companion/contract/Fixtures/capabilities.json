{
  "product": "tesserae",
  "server_version": "0.205.0",
  "api": {
    "name": "companion",
    "version": 1
  },
  "pairing": {
    "supported": true,
    "code_length": 6,
    "ttl_seconds": 600
  },
  "features": [
    "devices",
    "dashboards",
    "dashboard_push",
    "image_push",
    "jobs"
  ],
  "limits": {
    "image_upload_bytes": 26214400,
    "image_max_edge": 8192,
    "image_content_types": [
      "image/jpeg",
      "image/png",
      "image/heic",
      "image/heif",
      "image/webp"
    ],
    "job_retention_seconds": 86400,
    "idempotency_retention_seconds": 86400
  },
  "web_url": "/"
}
