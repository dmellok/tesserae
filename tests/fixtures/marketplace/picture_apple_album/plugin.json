{
  "tesserae_compat": "1.x",
  "name": "Picture, Apple Shared Album",
  "version": "0.2.1",
  "kind": "widget",
  "description": "Rotates through photos in a public iCloud Shared Album, full bleed. Turn on the album's public link in Photos, then paste the link (https://photos.icloud.com/shared/album/…, https://share.icloud.com/photos/…, or the older https://www.icloud.com/sharedalbum/#…) or just its token. Videos are skipped. NOTE: uses Apple's undocumented shared-album endpoints (the iCloud Photos web app's anonymous CloudKit calls, and the older sharedstreams API).",
  "icon": "ph-cloud-arrow-down",
  "supports": { "sizes": ["sm", "md", "lg"] },
  "cell_options": [
    {
      "name": "album",
      "type": "string",
      "label": "Album share link or token",
      "default": ""
    },
    {
      "name": "orientation",
      "type": "select",
      "label": "Orientation filter",
      "default": "any",
      "choices": [
        { "value": "any",       "label": "Any" },
        { "value": "portrait",  "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "square",    "label": "Square" }
      ]
    },
    {
      "name": "mode",
      "type": "select",
      "label": "Selection",
      "default": "random",
      "choices": [
        { "value": "random",     "label": "Random each render" },
        { "value": "sequential", "label": "Sequential (rotates one per render)" }
      ]
    },
    {
      "name": "scale",
      "type": "select",
      "label": "Scale",
      "default": "fill",
      "choices": [
        { "value": "fit",     "label": "Fit (letterbox)" },
        { "value": "fill",    "label": "Fill (crop to cover)" },
        { "value": "stretch", "label": "Stretch (distort to fill)" },
        { "value": "blurred", "label": "Fit with blurred background" }
      ]
    },
    { "name": "show_caption", "type": "boolean", "label": "Show date + album-name overlay", "default": true },
    { "name": "show_sequence", "type": "boolean", "label": "Show sequence indicator (3 / 12)", "default": true }
  ],
  "lineups": {
    "draw": true
  },
  "render": { "dither": "floyd-steinberg", "needs_network": true, "full_bleed": true }
}
