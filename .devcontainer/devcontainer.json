// One-click Codespaces / VS Code Dev Containers setup for Tesserae.
//
// What you get when this opens:
// * Python 3.11 (the minimum Tesserae supports — matches the floor in
//   pyproject.toml so we don't paper over a 3.11-specific bug by
//   testing on a newer interpreter).
// * `pip install -e '.[dev]'` already run.
// * The production server (``tesserae`` — Waitress, NOT Flask dev
//   reload) auto-starts on workspace open via a VS Code task defined
//   in ``.vscode/tasks.json`` (with ``runOn: folderOpen``). The task
//   shows up in a dedicated terminal panel labelled "Tesserae
//   server" so the user can scroll the log and kill / restart it
//   visually. We previously used ``postAttachCommand`` to nohup the
//   server in the background, but the dev container runtime would
//   sometimes reap the detached child mid-attach, leaving the badge
//   path silently broken. A VS Code task is the canonical
//   "auto-start a long-running process on workspace open" pattern
//   and survives any attach quirks. ``task.allowAutomaticTasks`` is
//   set below so Codespaces users don't get prompted.
// * We serve prod because Codespaces is a test-drive environment,
//   not a code-iteration loop — running prod matches what users see
//   on their Pi / Docker host, and dodges the Flask-dev "DO NOT USE
//   IN PRODUCTION" banner that would confuse first-time testers.
// * Port 8765 forwarded with a VS Code preview attached, so the
//   admin UI pops in a side panel as soon as the server is ready.
// * fonts-noto-color-emoji installed for parity with the production
//   Docker image (without it, flag glyphs in widgets render as
//   monochrome boxes on Linux — macOS preview hides this issue).
// * Ruff format-on-save wired up matching the repo's CI rules.
//
// Want to switch to the dev server (Flask reload, /__debug__)?
// Kill the running task (terminal panel ▸ trash icon) and run
// ``tesserae --dev`` in a fresh terminal.
//
// Optional follow-ups the postCreate does NOT do (keep boot fast):
// * `playwright install chromium` — only needed for screenshot
//   capture scripts under scripts/. Skip unless you're regenerating
//   the widget gallery.
// * Pulling an MQTT broker into the container — running the wizard
//   without a broker works fine; the broker step is optional.
{
  "name": "Tesserae",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Tesserae admin UI",
      "onAutoForward": "openPreview"
    }
  },
  // Block the IDE / terminal until ``postCreateCommand`` finishes.
  // Without this, the user can open a terminal mid-install and hit
  // ``tesserae: command not found``, which read as a setup failure
  // even though pip was still running. The Codespaces UI keeps a
  // "Setting up dev container" progress card visible until this
  // resolves, so the install is at least signalled rather than
  // silent. Boot time on a clean Codespace is ~60–90s; subsequent
  // attaches skip postCreate entirely and only run postAttach.
  // For true ~30s cold-start, enable prebuilds in repo Settings →
  // Codespaces → Set up prebuild (bakes pip install into the image
  // at GitHub Actions time so the badge launches an
  // already-provisioned container).
  "waitFor": "postCreateCommand",
  // ``sudo rm -f /etc/apt/sources.list.d/yarn.list`` strips the Yarn
  // apt source the base image ships with. We don't use Yarn here, and
  // Yarn's GPG key rotates / expires periodically — when it does,
  // ``apt-get update`` errors with ``NO_PUBKEY 62D54FD4003F6525`` and
  // takes the whole postCreate down with it (exit 100). Removing the
  // list file dodges the broken signature without us having to chase
  // their key rotation. Same problem hit Codespaces users on 2026-06-22.
  "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y --no-install-recommends fonts-noto-color-emoji && sudo rm -rf /var/lib/apt/lists/* && pip install --upgrade pip && pip install -e '.[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        },
        "ruff.format.args": [],
        "ruff.lint.args": [],
        // Lets the .vscode/tasks.json "Tesserae server" task auto-run
        // on workspace open without prompting the user. Scoped to
        // this Codespace via customizations.vscode.settings, so it
        // doesn't leak into the user's global preferences.
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
