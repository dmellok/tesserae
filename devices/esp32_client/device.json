{
  "tesserae_compat": "1.x",
  "name": "ESP32 client",
  "icon": "device-tablet",
  "version": "0.1.0",
  "description": "Battery-powered ESP32 firmware that subscribes to tesserae/esp32/frame/bin (retained), paints the panel via SPI, and goes back to deep sleep. Publishes battery / RSSI / IP heartbeats on wake; reads its sleep-interval config from the broker.",
  "renderers": ["esp32_bin"],
  "status_topic": "tesserae/esp32/status",
  "config_topic": "tesserae/esp32/config",
  "panel": { "w": 800, "h": 480, "orientation": "landscape", "name": "ESP32 e-paper" },
  "config_schema": {
    "sleep_interval_s": {
      "type": "int",
      "label": "Sleep interval",
      "default": 60,
      "min": 30,
      "max": 604800,
      "presets": [
        {"value": 60,    "label": "1 minute"},
        {"value": 300,   "label": "5 minutes"},
        {"value": 900,   "label": "15 minutes"},
        {"value": 1800,  "label": "30 minutes"},
        {"value": 3600,  "label": "1 hour"},
        {"value": 21600, "label": "6 hours"},
        {"value": 43200, "label": "12 hours"},
        {"value": 86400, "label": "1 day"}
      ],
      "help": "Custom value is in seconds."
    }
  }
}
