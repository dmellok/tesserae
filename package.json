{
  "name": "tesserae-frontend-lint",
  "version": "0.0.0",
  "private": true,
  "description": "Lint/format tooling for the hand-rolled static/ frontend. Not a build step; the app ships the JS/CSS as-is.",
  "type": "module",
  "scripts": {
    "lint:js": "eslint \"static/**/*.js\"",
    "lint:css": "stylelint \"static/**/*.css\"",
    "format:check": "prettier --check \"static/**/*.{js,css}\"",
    "format:write": "prettier --write \"static/**/*.{js,css}\"",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.14.1",
    "stylelint-config-recommended": "^15.0.0"
  }
}
