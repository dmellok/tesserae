// VS Code task that auto-starts the Tesserae prod server when the
// workspace opens.
//
// Specifically here so the Codespaces "open from badge" path lands
// users at a running server without them having to type anything.
// ``runOn: folderOpen`` triggers the task immediately on workspace
// load; ``isBackground: true`` keeps VS Code from blocking the IDE
// on it; ``panel: dedicated`` gives the user a labelled terminal
// they can scroll for logs (and kill / restart visually).
//
// Auto-run requires ``task.allowAutomaticTasks: "on"``; the
// devcontainer's ``customizations.vscode.settings`` enables it so
// Codespaces opens don't prompt. For local clones outside
// Codespaces the user gets a one-time "allow automatic tasks?"
// prompt the first time the workspace is opened — fine, since
// local usage isn't the badge path.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tesserae server",
      "type": "shell",
      "command": "tesserae",
      "isBackground": true,
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
